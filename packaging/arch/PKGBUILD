pkgname=ohmywu
pkgver=0.25.0
pkgrel=1
pkgdesc="Desktop AI workspace built with Tauri"
arch=('x86_64')
url="https://github.com/wuwuwu-lxb/ohmywu"
license=('custom')
depends=(
  'webkit2gtk'
  'gtk3'
  'glib2'
  'gcc-libs'
  'hicolor-icon-theme'
)
source=(
  "ohmywu-bin"
  "ohmywu-128x128.png"
)
sha256sums=(
  'SKIP'
  'SKIP'
)

build() {
  :
}

package() {
  install -Dm755 "${srcdir}/ohmywu-bin" "${pkgdir}/usr/bin/ohmywu"
  install -Dm644 "${srcdir}/ohmywu-128x128.png" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/ohmywu.png"

  install -d "${pkgdir}/usr/share/licenses/${pkgname}"
  printf '%s\n' "OhMyWu is distributed from ${url}." > "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
